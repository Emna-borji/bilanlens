# Environnements virtuels
.venv/
venv/
env/
ENV/

# Caches Python et pytest
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Streamlit
.streamlit/secrets.toml

# Variables d'environnement
.env
.env.*
!.env.example

# Fichiers système / éditeurs
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Fichiers temporaires et logs
*.log
*.tmp
*.bak
tmp/
scratch/

# Distribution et packaging
build/
dist/
*.egg-info/
*.egg

# Jupyter
.ipynb_checkpoints/

# OCR intermédiaires
*.ocr.cache

# Index Chroma : régénérable depuis `data/chunks/*.jsonl` par
# `scripts/index_chunks.py`. Binaire SQLite + HNSW, non diffable.
/data/chroma/

# Cache des embeddings (API Gemini) : regenerable, specifique a la
# machine, peut contenir des vecteurs calcules sur des textes privés
# si le corpus change. Toujours gitignore.
/data/cache_embeddings/

# Fichiers personnels (dépôt public)
/notes
/FinSight Agent*.pdf
